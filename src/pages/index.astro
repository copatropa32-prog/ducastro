    <!-- Scripts de Interatividade -->
    <script>
      // Função para rolar o Carrossel
      function scrollCarousel(direction) {
        const container = document.getElementById('carousel-container');
        const scrollAmount = 320;
        if (direction === 'left') {
          container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }
      window.scrollCarousel = scrollCarousel;

      // Filtro por Abas da Vitrine
      function filterProducts(category, btnElement) {
        const cards = document.querySelectorAll('.product-card');
        const buttons = document.querySelectorAll('.filter-btn');

        buttons.forEach(btn => {
          btn.classList.remove('bg-orange-500', 'text-white', 'font-extrabold', 'shadow-sm');
          btn.classList.add('bg-orange-50', 'text-slate-700', 'border', 'border-orange-200');
        });

        if (btnElement) {
          btnElement.classList.remove('bg-orange-50', 'text-slate-700', 'border', 'border-orange-200');
          btnElement.classList.add('bg-orange-500', 'text-white', 'font-extrabold', 'shadow-sm');
        }

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (category === 'all' || cardCat === category) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }
      window.filterProducts = filterProducts;

      // Simulador de Lista no WhatsApp
      const checkboxes = document.querySelectorAll('.item-checkbox');
      const totalPriceEl = document.getElementById('total-price');
      const sendListBtn = document.getElementById('send-list-btn');
      const phoneNum = "5512991422547";

      function updateListTotal() {
        let total = 0;
        let selectedItems = [];

        checkboxes.forEach(chk => {
          if (chk.checked) {
            const priceStr = chk.getAttribute('data-price') || "0";
            total += parseFloat(priceStr.replace(',', '.'));
            selectedItems.push(chk.value);
          }
        });

        if (totalPriceEl) {
          totalPriceEl.textContent = `R$ ${total.toFixed(2).replace('.', ',')}`;
        }

        if (selectedItems.length > 0) {
          sendListBtn.removeAttribute('disabled');
          const message = encodeURIComponent(`Olá! Gostaria de encomendar a seguinte lista de compras:\n\n- ${selectedItems.join('\n- ')}\n\n*Total Estimado: R$ ${total.toFixed(2).replace('.', ',')}*`);
          sendListBtn.onclick = () => {
            window.open(`https://wa.me/${phoneNum}?text=${message}`, '_blank');
          };
        } else {
          sendListBtn.setAttribute('disabled', 'true');
        }
      }

      checkboxes.forEach(chk => {
        chk.addEventListener('change', updateListTotal);
      });
    </script>

