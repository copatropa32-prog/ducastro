---
// Supermercado Ducastro - Home Page Oficial (Tema Claro: Branco e Laranja)
const whatsappNumber = "5512991422547"; 
const whatsappMessage = encodeURIComponent("Olá! Vim pelo site do Supermercado Ducastro e quero garantir meu cupom especial da Semana do Cliente!");

const ofertas = [
  // Açougue
  { id: 1, item: "Acém Bovina kg", preco: "39,99", antigo: "45,90", categoria: "acougue", imagem: "/imagens/acougue/acem-bovino-sem-osso-resfriado-pedaco-kg.webp", desconto: "13% OFF" },
  { id: 2, item: "Costela Boi Ripa kg", preco: "26,99", antigo: "32,90", categoria: "acougue", imagem: "/imagens/acougue/costela-boi-ripa.webp", desconto: "18% OFF" },
  { id: 3, item: "Bife Especial kg", preco: "39,99", antigo: "46,90", categoria: "acougue", imagem: "/imagens/acougue/bife-especial.webp", desconto: "15% OFF" },
  { id: 4, item: "Linguiça Toscana Aurora kg", preco: "21,59", antigo: "25,90", categoria: "acougue", imagem: "/imagens/acougue/linguica-toscana-aurora.webp", desconto: "17% OFF" },
  
  // Hortifrúti
  { id: 5, item: "Mamão Papaia kg", preco: "4,59", antigo: "6,50", categoria: "hortifruti", imagem: "/imagens/hortifruti/mamao-papaia.webp", desconto: "29% OFF" },
  { id: 6, item: "Maçã Gala kg", preco: "4,99", antigo: "6,90", categoria: "hortifruti", imagem: "/imagens/hortifruti/maca-gala.webp", desconto: "28% OFF" },
  { id: 7, item: "Melancia kg", preco: "2,99", antigo: "4,20", categoria: "hortifruti", imagem: "/imagens/hortifruti/melancia.webp", desconto: "28% OFF" },
  { id: 8, item: "Tomate Italiano kg", preco: "8,99", antigo: "11,90", categoria: "hortifruti", imagem: "/imagens/hortifruti/tomate-italiano.webp", desconto: "24% OFF" },

  // Alimentos / Despensa
  { id: 9, item: "Arroz Saboroso Tipo 1 5kg", preco: "18,99", antigo: "22,90", categoria: "alimentos", imagem: "/imagens/alimentos/arroz-saboroso-tipo-1-5kg.webp", desconto: "17% OFF" },
  { id: 10, item: "Feijão Carioca Solito 1kg", preco: "8,39", antigo: "10,50", categoria: "alimentos", imagem: "/imagens/alimentos/feijao-carioca-solito-tipo-1-1kg.webp", desconto: "20% OFF" },
  { id: 11, item: "Macarrão Parafuso Camil 1kg", preco: "2,99", antigo: "4,20", categoria: "alimentos", imagem: "/imagens/alimentos/macarrao-parafuso-camil-1kg.webp", desconto: "28% OFF" },
  { id: 12, item: "Nescau Lata 350ml", preco: "9,99", antigo: "12,50", categoria: "alimentos", imagem: "/imagens/alimentos/nescau-350ml.webp", desconto: "20% OFF" },

  // Bebidas
  { id: 13, item: "Suco Laranja Life 900ml", preco: "9,99", antigo: "12,90", categoria: "bebidas", imagem: "/imagens/bebidas/suco-laranja-life-900ml.webp", desconto: "22% OFF" },

  // Higiene
  { id: 14, item: "Desodorante Monange 150ml", preco: "10,99", antigo: "14,50", categoria: "higiene", imagem: "/imagens/higiene/desodorante-monange-150ml.webp", desconto: "24% OFF" },
  { id: 15, item: "Kit Shampoo + Condicionador Skala", preco: "16,89", antigo: "21,90", categoria: "higiene", imagem: "/imagens/higiene/kit-shampoo-e-condicionador-amor-poderoso-325ml.webp", desconto: "23% OFF" }
];
---

<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Supermercado Ducastro | Casa Branca - Caraguatatuba</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Plus Jakarta Sans', 'sans-serif'],
            },
          },
        },
      }
    </script>
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body class="bg-white text-slate-800 antialiased selection:bg-orange-500 selection:text-white">

    <!-- HEADER -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-orange-100 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <a href="#" class="flex items-center space-x-3 group">
            <div class="w-12 h-12 rounded-2xl bg-orange-50 border border-orange-200 flex items-center justify-center p-1 shadow-sm overflow-hidden">
              <img src="/logo.png" alt="Supermercado Ducastro" class="w-full h-full object-contain group-hover:scale-105 transition-transform" />
            </div>
            <div class="flex flex-col">
              <span class="font-black text-lg tracking-tight text-slate-900 leading-none">DUCASTRO</span>
              <span class="text-[10px] font-extrabold text-orange-600 tracking-wider mt-0.5">SUPERMERCADOS</span>
            </div>
          </a>
          <span class="text-xs uppercase tracking-widest text-orange-600 font-extrabold hidden md:inline-block px-3 py-1 bg-orange-50 rounded-full border border-orange-200 ml-2">Casa Branca • Caraguá</span>
        </div>

        <nav class="hidden md:flex items-center space-x-8 font-semibold text-sm text-slate-600">
          <a href="#diadociente" class="hover:text-orange-600 transition-colors text-orange-600 font-bold">Semana do Cliente</a>
          <a href="#carrossel" class="hover:text-orange-600 transition-colors">Ofertas Imbatíveis</a>
          <a href="#ofertas" class="hover:text-orange-600 transition-colors">Todas as Ofertas</a>
          <a href="#montalista" class="hover:text-orange-600 transition-colors">Monte sua Lista</a>
          <a href="#clube" class="hover:text-orange-600 transition-colors">Clube Prêmios</a>
          <a href="#localizacao" class="hover:text-orange-600 transition-colors">Localização</a>
        </nav>

        <a 
          href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-orange-500 hover:bg-orange-600 text-white text-sm font-bold px-6 py-3 rounded-xl shadow-md shadow-orange-500/20 transition-all hover:scale-105 flex items-center space-x-2"
        >
          <span>Chamar no WhatsApp</span>
        </a>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section class="relative bg-gradient-to-b from-orange-50 via-white to-white text-slate-900 py-16 lg:py-24 overflow-hidden border-b border-orange-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="lg:w-2/3 space-y-6">
          <span class="inline-flex items-center gap-2 bg-orange-100 text-orange-700 border border-orange-200 text-xs uppercase font-extrabold tracking-wider px-4 py-2 rounded-full shadow-sm">
            <svg class="w-4 h-4 text-orange-600 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
            🛒 | Ofertas válidas de 16 a 20/09/26 ou enquanto durarem os estoques!
          </span>

          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-none text-slate-900">
            Você é a parte mais <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-500">importante da nossa história.</span>
          </h1>
          <p class="text-lg text-slate-600 max-w-xl font-normal leading-relaxed">
            Na Semana do Cliente, agradecemos por fazer parte da nossa família no Casa Branca. Aproveite nossas ofertas e monte sua lista de compras direto por aqui!
          </p>
          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a href="#montalista" class="bg-orange-500 hover:bg-orange-600 text-white font-extrabold px-8 py-4 rounded-2xl shadow-lg shadow-orange-500/25 transition-all text-center hover:-translate-y-0.5">
              🛒 Monte sua Lista
            </a>
            <a href="#carrossel" class="bg-white hover:bg-orange-50 border border-orange-200 text-slate-700 font-bold px-8 py-4 rounded-2xl transition-all text-center shadow-sm">
              Ver Ofertas Imbatíveis
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CARROSSEL DE OFERTAS IMBATÍVEIS -->
    <section id="carrossel" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <span class="text-orange-600 font-bold text-sm uppercase tracking-wider flex items-center gap-2">
            🔥 Destaques da Semana
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1 tracking-tight">Ofertas Imbatíveis</h2>
        </div>
        <!-- Botões de Navegação do Carrossel -->
        <div class="hidden sm:flex items-center gap-2">
          <button onclick="scrollCarousel('left')" class="w-12 h-12 rounded-2xl bg-orange-50 hover:bg-orange-500 hover:text-white border border-orange-200 text-orange-600 flex items-center justify-center font-bold text-xl transition-all shadow-sm cursor-pointer">
            ←
          </button>
          <button onclick="scrollCarousel('right')" class="w-12 h-12 rounded-2xl bg-orange-50 hover:bg-orange-500 hover:text-white border border-orange-200 text-orange-600 flex items-center justify-center font-bold text-xl transition-all shadow-sm cursor-pointer">
            →
          </button>
        </div>
      </div>

      <!-- Container Deslizante do Carrossel -->
      <div id="carousel-container" class="flex gap-6 overflow-x-auto no-scrollbar scroll-smooth pb-4 px-1">
        {ofertas.slice(0, 8).map((produto) => (
          <div class="min-w-[280px] sm:min-w-[300px] max-w-[300px] bg-white border border-orange-200 rounded-3xl p-6 flex flex-col justify-between shadow-lg hover:shadow-2xl hover:border-orange-400 transition-all shrink-0">
            <div>
              <div class="w-full h-48 bg-orange-50/50 rounded-2xl mb-4 overflow-hidden border border-orange-100 flex items-center justify-center p-2 relative">
                <span class="absolute top-2 right-2 bg-rose-500 text-white text-[10px] font-black px-2.5 py-1 rounded-full shadow-sm">
                  {produto.desconto}
                </span>
                <img src={produto.imagem} alt={produto.item} class="w-full h-full object-contain hover:scale-105 transition-transform" />
              </div>
              <span class="bg-orange-50 text-orange-700 text-xs font-bold px-3 py-1 rounded-full border border-orange-200 capitalize inline-block mb-2">
                {produto.categoria}
              </span>
              <h3 class="font-extrabold text-slate-900 text-lg mb-1 leading-snug">{produto.item}</h3>
              <p class="text-xs text-slate-500">Supermercado Ducastro</p>
            </div>
            <div class="pt-6 border-t border-slate-100 flex items-end justify-between mt-6">
              <div>
                <span class="text-xs text-slate-400 line-through block">R$ {produto.antigo}</span>
                <span class="text-2xl font-black text-orange-600">R$ {produto.preco}</span>
              </div>
              <a 
                href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Quero aproveitar a oferta imbatível: ${produto.item} por R$ ${produto.preco}`)}`}
                target="_blank"
                class="bg-orange-500 hover:bg-orange-600 text-white font-black text-xs px-4 py-2.5 rounded-xl transition-all shadow-md shadow-orange-500/20"
              >
                Pedir
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SEÇÃO ESPECIAL SEMANA DO CLIENTE -->
    <section id="diadociente" class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-orange-500 via-orange-600 to-amber-600 border border-orange-400 rounded-3xl p-8 sm:p-12 shadow-xl relative overflow-hidden text-white">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-6">
            <span class="inline-flex items-center gap-2 bg-white text-orange-700 font-black text-xs px-3.5 py-1.5 rounded-full uppercase tracking-wider shadow-sm">
              <span>Especial de Aniversário / Ofertas</span>
            </span>
            <h2 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
              Semana do Cliente Ducastro!
            </h2>
            <p class="text-orange-50 text-base sm:text-lg leading-relaxed font-medium">
              Fazemos entregas nas compras acima de R$ 300,00 (consulte localidades atendidas) e parcelamos sua compra em até 3x no cartão. Garanta suas ofertas agora!
            </p>
          </div>
          <div class="lg:col-span-5 bg-white text-slate-900 border border-orange-100 rounded-2xl p-6 sm:p-8 text-center space-y-6 shadow-2xl">
            <div class="w-16 h-16 bg-orange-100 border border-orange-200 rounded-2xl flex items-center justify-center mx-auto text-orange-600 text-3xl">
              🎁
            </div>
            <div>
              <h3 class="text-xl font-black text-slate-900">Garanta o seu Cupom VIP</h3>
              <p class="text-xs text-slate-500 mt-1">Chame no WhatsApp agora e receba atendimento prioritário.</p>
            </div>
            <a 
              href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Olá! Quero resgatar meu benefício especial da Semana do Cliente no Supermercado Ducastro.")}`}
              target="_blank"
              class="w-full block bg-orange-500 hover:bg-orange-600 text-white font-black text-sm py-4 rounded-xl shadow-lg shadow-orange-500/20 transition-all transform hover:scale-105 text-center"
            >
              Resgatar no WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- OFERTAS COM FILTROS POR ABAS -->
    <section id="ofertas" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
        <div>
          <span class="text-orange-600 font-bold text-sm uppercase tracking-wider flex items-center gap-2">
            <svg class="w-4 h-4 text-orange-600 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
            Economia garantida
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1 tracking-tight">Todas as Ofertas</h2>
        </div>
      </div>

      <!-- Abas de Filtro -->
      <div class="flex flex-wrap gap-2 mb-8 border-b border-orange-100 pb-4">
        <button onclick="filterProducts('all', this)" class="filter-btn active bg-orange-500 text-white font-extrabold text-xs px-5 py-2.5 rounded-xl transition-all cursor-pointer shadow-sm">Todas</button>
        <button onclick="filterProducts('acougue', this)" class="filter-btn bg-orange-50 text-slate-700 hover:bg-orange-100 font-bold text-xs px-5 py-2.5 rounded-xl transition-all border border-orange-200 cursor-pointer">🥩 Açougue</button>
        <button onclick="filterProducts('hortifruti', this)" class="filter-btn bg-orange-50 text-slate-700 hover:bg-orange-100 font-bold text-xs px-5 py-2.5 rounded-xl transition-all border border-orange-200 cursor-pointer">🍎 Hortifrúti</button>
        <button onclick="filterProducts('alimentos', this)" class="filter-btn bg-orange-50 text-slate-700 hover:bg-orange-100 font-bold text-xs px-5 py-2.5 rounded-xl transition-all border border-orange-200 cursor-pointer">🥫 Alimentos</button>
        <button onclick="filterProducts('bebidas', this)" class="filter-btn bg-orange-50 text-slate-700 hover:bg-orange-100 font-bold text-xs px-5 py-2.5 rounded-xl transition-all border border-orange-200 cursor-pointer">🧃 Bebidas</button>
        <button onclick="filterProducts('higiene', this)" class="filter-btn bg-orange-50 text-slate-700 hover:bg-orange-100 font-bold text-xs px-5 py-2.5 rounded-xl transition-all border border-orange-200 cursor-pointer">🧴 Higiene</button>
      </div>

      <!-- Grid de Produtos -->
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {ofertas.map((produto) => (
          <div class={`product-card bg-white border border-orange-100 rounded-3xl p-6 flex flex-col justify-between shadow-md hover:shadow-xl hover:border-orange-300 transition-all`} data-category={produto.categoria}>
            <div>
              <div class="w-full h-48 bg-orange-50/50 rounded-2xl mb-4 overflow-hidden border border-orange-100 flex items-center justify-center p-2">
                <img src={produto.imagem} alt={produto.item} class="w-full h-full object-contain hover:scale-105 transition-transform" />
              </div>
              <div class="flex items-center justify-between mb-3">
                <span class="bg-orange-50 text-orange-700 text-xs font-bold px-3 py-1 rounded-full border border-orange-200 capitalize">
                  {produto.categoria}
                </span>
                <span class="bg-rose-50 text-rose-600 text-xs font-black px-2.5 py-1 rounded-full border border-rose-200">
                  {produto.desconto}
                </span>
              </div>
              <h3 class="font-extrabold text-slate-900 text-lg mb-1 leading-snug">{produto.item}</h3>
              <p class="text-xs text-slate-500">Qualidade garantida Ducastro</p>
            </div>
            <div class="pt-6 border-t border-slate-100 flex items-end justify-between mt-6">
              <div>
                <span class="text-xs text-slate-400 line-through block">R$ {produto.antigo}</span>
                <span class="text-2xl font-black text-orange-600">R$ {produto.preco}</span>
              </div>
              <a 
                href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Quero aproveitar a oferta: ${produto.item} por R$ ${produto.preco}`)}`}
                target="_blank"
                class="bg-orange-500 hover:bg-orange-600 text-white font-black text-xs px-4 py-2.5 rounded-xl transition-all shadow-md shadow-orange-500/20"
              >
                Pedir
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SIMULADOR DE "MONTE SUA LISTA" -->
    <section id="montalista" class="py-16 bg-orange-50/60 border-y border-orange-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center space-y-3 mb-10">
          <span class="text-orange-600 font-bold text-sm uppercase tracking-wider">Praticidade Total</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">Monte sua Cesta Econômica</h2>
          <p class="text-slate-600 text-sm max-w-xl mx-auto">Selecione os itens que precisa para a sua casa. O valor será somado automaticamente para você enviar direto no WhatsApp!</p>
        </div>

        <div class="bg-white border border-orange-200 rounded-3xl p-6 sm:p-8 shadow-xl space-y-6">
          <div id="checklist-items" class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-h-[400px] overflow-y-auto pr-2">
            {ofertas.map((produto) => (
              <label class="flex items-center justify-between p-4 rounded-2xl bg-orange-50/40 border border-orange-100 hover:border-orange-300 cursor-pointer transition-all">
                <div class="flex items-center space-x-3">
                  <input 
                    type="checkbox" 
                    value={produto.item} 
                    data-price={produto.preco}
                    class="item-checkbox w-5 h-5 accent-orange-500 rounded cursor-pointer"
                  />
                  <div>
                    <span class="block font-bold text-slate-800 text-sm">{produto.item}</span>
                    <span class="text-xs text-orange-600 font-bold">R$ {produto.preco}</span>
                  </div>
                </div>
              </label>
            ))}
          </div>

          <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <span class="text-xs text-slate-500 block">Total Estimado da Lista:</span>
              <span id="total-price" class="text-3xl font-black text-orange-600">R$ 0,00</span>
            </div>
            <button 
              id="send-list-btn"
              class="w-full sm:w-auto bg-orange-500 hover:bg-orange-600 text-white font-black px-8 py-4 rounded-xl shadow-lg shadow-orange-500/20 transition-all text-center cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
              disabled
            >
              Enviar Lista para o WhatsApp 🚀
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- CLUBE PRÊMIOS -->
    <section id="clube" class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-r from-orange-500 via-orange-600 to-amber-600 border border-orange-400 rounded-3xl p-8 sm:p-14 shadow-xl flex flex-col lg:flex-row items-center justify-between gap-8 text-white">
          <div class="space-y-4 max-w-xl text-center lg:text-left">
            <span class="inline-flex items-center gap-2 bg-white text-orange-700 text-xs font-extrabold uppercase tracking-wider px-3.5 py-1.5 rounded-full shadow-sm">
              Vantagens Exclusivas
            </span>
            <h2 class="text-3xl sm:text-4xl font-black tracking-tight">Clube Prêmios Ducastro</h2>
            <p class="text-orange-50 text-base font-medium">
              Cadastre-se de graça, acumule pontos a cada compra no supermercado e concorra a prêmios todos os meses!
            </p>
          </div>
          <a 
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Quero me cadastrar no Clube Prêmios Ducastro!")}`}
            target="_blank"
            class="w-full sm:w-auto bg-white hover:bg-orange-50 text-orange-700 font-black px-8 py-4 rounded-2xl shadow-xl transition-all text-center whitespace-nowrap hover:scale-105"
          >
            Quero Participar Gratuitamente
          </a>
        </div>
      </div>
    </section>

    <!-- LOCALIZAÇÃO -->
    <section id="localizacao" class="py-20 bg-orange-50/40 border-t border-orange-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900">Venha nos Visitar</h2>
          <p class="text-slate-600 mt-2">Rua Antônio Henrique de Mesquita, 17 - Jardim Casa Branca, Caraguatatuba - SP</p>
        </div>
