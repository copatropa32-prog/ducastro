---
const categories = [
  {
    id: "hortifruti",
    title: "Frutas, Verduras e Legumes",
    desc: "Produtos frescos selecionados todos os dias para garantir sabor e saúde para sua família.",
    image: "https://images.unsplash.com/photo-1610348725531-843dff563e2c?auto=format&fit=crop&w=600&q=80",
    badge: "Fresco do Dia"
  },
  {
    id: "padaria",
    title: "Padaria & Lanches Naturais",
    desc: "Pãezinhos quentinhos saindo do forno, lanches naturais preparados com carinho e qualidade.",
    image: "https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=600&q=80",
    badge: "Saindo do Forno"
  },
  {
    id: "doces",
    title: "Doces, Bombas & Bolos",
    desc: "Bombas de doce de leite, bolos recheados confeitados e sobremesas irresistíveis.",
    image: "https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=600&q=80",
    badge: "Artesanal"
  }
];
---

<section id="hortifruti" class="py-16 px-4 bg-stone-50">
  <div class="max-w-7xl mx-auto space-y-12">
    <div class="text-center space-y-3">
      <h2 class="text-3xl font-bold text-stone-800">Nossos Setores</h2>
      <p class="text-stone-600 max-w-xl mx-auto">Tudo o que você precisa reunido em um só lugar com o melhor atendimento de Caraguatatuba.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {categories.map((cat) => (
        <div id={cat.id} class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition border border-stone-100 flex flex-col justify-between">
          <div>
            <div class="relative h-48 overflow-hidden">
              <img src={cat.image} alt={cat.title} class="w-full h-full object-cover hover:scale-105 transition duration-500" />
              <span class="absolute top-3 left-3 bg-amber-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow">
                {cat.badge}
              </span>
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-xl font-bold text-stone-800">{cat.title}</h3>
              <p class="text-stone-600 text-sm leading-relaxed">{cat.desc}</p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a 
              href={`https://wa.me/5512991422547?text=Olá!%20Gostaria%20de%20encomendar%20itens%20do%20setor:%20${cat.title}`}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center bg-stone-900 hover:bg-amber-600 text-white font-semibold py-3 rounded-xl transition text-sm shadow"
            >
              Pedir pelo WhatsApp
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>